  shopOpenDialogues:
  - clip: {fileID: 8300000, guid: da694ac57499c5e45bac5c19f257ddd7, type: 3}
    subtitle: Got some rare things on sale stranger...
    volumeScale: 0.586
    subtitleDurationOverride: 0
  - clip: {fileID: 8300000, guid: de48cde35e55c004690e87a5685c48b3, type: 3}
    subtitle: I've got weapons, ammo, and supplies. Whatever you need!
    volumeScale: 0.586
    subtitleDurationOverride: 0
  - clip: {fileID: 8300000, guid: e2c6567ce13b38c44978f54aaeed0de2, type: 3}
    subtitle: "I\u2019ve been waiting for a customer! Or a sentient toaster... At
      this point honestly, I'm not picky."
    volumeScale: 0.586
    subtitleDurationOverride: 0
  - clip: {fileID: 8300000, guid: b0c155d27248adc41b364a34a7b20264, type: 3}
    subtitle: Take your time. Have a look at what's available.
    volumeScale: 0.586
    subtitleDurationOverride: 0
  - clip: {fileID: 8300000, guid: 5cbb087a517b4f243bcf4ca33b0dfc27, type: 3}
    subtitle: Welcome to the shop. What can I get you?
    volumeScale: 0.586
    subtitleDurationOverride: 0
  - clip: {fileID: 8300000, guid: b6631ac6fb628ec47a6cd4bfa7a1269b, type: 3}
    subtitle: "What\u2019re ya buyin\u2026 See what I did there?"
    volumeScale: 0.586
    subtitleDurationOverride: 0
