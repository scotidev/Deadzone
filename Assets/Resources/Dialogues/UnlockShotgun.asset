  dialogues:
  - clip: {fileID: 8300000, guid: a105c2a96aa49e34eba0f019afe13e73, type: 3}
    subtitle: Ah, the room-clearer. Perfect for the survivor who finds aiming to
      be an unnecessary intellectual burden.
  - clip: {fileID: 8300000, guid: 8fe144303373ed740ba6b0e70f3ce66f, type: 3}
    subtitle: "I\u2019ve unlocked the boom-stick. It\u2019s loud, messy, and lacks
      any sense of sophistication. You two will get along famously."
  - clip: {fileID: 8300000, guid: 7fe2285e50efe02479707859dd91e464, type: 3}
    subtitle: "One shotgun, coming up. It\u2019s basically a delete button for anything
      within five feet."
